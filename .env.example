# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint; for Ollama Cloud use https://ollama.com/v1
OPENAI_BASE_URL=
# Optional separate model for the live LLM Judge; defaults to OPENAI_MODEL
OPENAI_JUDGE_MODEL=
# Independent live Judge gate: every criterion must meet this score
LLM_JUDGE_THRESHOLD=0.6
